# Lab-only credentials. Every service binds to 127.0.0.1. Change these before exposing anything.
# `make env` copies this file to .env (gitignored) if .env does not exist yet.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops-lab-change-me
S3_ACCESS_KEY=mlops
S3_SECRET_KEY=mlops-lab-change-me
S3_REGION=us-east-1
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin-lab-change-me
# Fixed so restarts keep sessions; generate your own with: python -c "import secrets;print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=change-me-lab-only

# Host ports (all on 127.0.0.1), in a 3xxxx range so this lab can run next to the others.
PORT_AIRFLOW=38080
PORT_MLFLOW=35000
PORT_API=38000
PORT_S3_API=39000
PORT_S3_CONSOLE=39001
PORT_FEAST_UI=38888
PORT_FEAST_SERVER=36566
PORT_EVIDENTLY_UI=38085
API_REFRESH_SECONDS=15
